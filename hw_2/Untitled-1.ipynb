   "metadata": {},
   "outputs": [],
   "source": [
    "y= np.array([0.0, 0.0, 0.0, 1.0])\n",
    "y_pred = np.array([0.1, 0.2, 0.6, 0.1])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "701efd0a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[0.10536052 0.22314355 0.91629073 2.30258509]\n",
      "\n"
     ]
    }
   ],
   "source": [
    "def cross_en(y,y_pred):\n",
    "    loss = -(y * np.log(y_pred) + (1 - y) * np.log(1 - y_pred))\n",
    "    return loss\n",
    "\n",
    "print(cross_en(y,y_pred))\n",
    "print()"
   ]
  }
